[Unit]
Description=Process private Resume Matcher vacancy requests
After=docker.service resume-t3.service
Requires=docker.service resume-t3.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/boat-services/resume/release-vacancy
ExecStart=/usr/bin/python3 scripts/boat-vacancy-worker.py
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
